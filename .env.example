# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. Never commit real credentials.
MONGODB_URI=your-url

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Minimum 32 characters. Use different secrets for access and refresh.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=crmrealestates
JWT_REFRESH_SECRET=crmrealestates
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. No wildcard in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# windowMs in milliseconds (900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─── Logging ──────────────────────────────────────────────────────────────────
# Levels: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
