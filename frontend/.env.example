# ==============================================================================
# AGENT-Broker Frontend Environment Configuration (.env.example)
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# SECURITY WARNING:
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# NEVER place backend secrets (JWT secrets, MongoDB URIs, Argon2 keys) in this file.
# ==============================================================================

# Backend API Base URL
# Points to Express backend server. By convention, backend routes are mounted at /api and /api/v1.
# Local development default: http://localhost:5000/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Application Display Name
NEXT_PUBLIC_APP_NAME="AGENT-Broker CRM"
